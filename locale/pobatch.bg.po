#, object-pascal-format
msgid "Done. %d translation(s) added in %d file(s). %d file(s) skipped."
msgstr "Готово. %d превод(а) са добавени в %d файл(a). %d файл(а) са пропуснати."

#: batchop.rdonetranslationscleared
#, object-pascal-format
msgid "Done. %d translation(s) cleared."
msgstr "Готово. %d превод(а) са изчистени."

