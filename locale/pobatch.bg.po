#: batchop.rclearinvalidtitle
msgid "Clear invalid translations"
msgstr "Изчисти невалидните преводи"

#: batchop.rconfirmrenametitle
msgid "Confirm rename"
msgstr "Потвърдете преименуването"

#: batchop.rconfirmsynctitle
msgid "Confirm synchronization"
msgstr "Потвърдете синхронизацията"

#: batchop.rcopiedtranslationscount
#, object-pascal-format
msgid "%d translations were copied."
msgstr "%d превода бяха копирани."

#: batchop.rcopysourceemptyconfirm
#, object-pascal-format
msgid ""
"Copy source text to empty translations in the following %d file(s)?\n"
"This action cannot be undone within the application.\n"
"\n"
"%s"
msgstr ""
"Сигурни ли сте, че искате да копирате изходния текст в празните преводи в следващите %d файл(a)?\n"
"Това действие не може да бъде отменено в приложението.\n"
"\n"
"%s"

#: batchop.rcopysourceemptytitle
msgid "Copy source to empty"
msgstr "Копиране на изходен текст в празни"

#: batchop.rcopysourcetotranslationconfirm
msgid "Copy source text to translations in the selected row(s)?"
msgstr "Сигурни ли сте, че искате да копирате изходния текст в преводите на избрания ред(ове)?"

#: batchop.rdeletefilestitle
msgid "Delete files"
msgstr "Изтриване на файлове"

#: batchop.rdeletemultipleconfirm
#, object-pascal-format
msgid ""
"Are you sure you want to delete the following %d file(s)?\n"
"\n"
"%s"
msgstr ""
"Сигурни ли сте, че искате да изтриете следващите %d файл(a)?\n"
"\n"
"%s"

#: batchop.rdeletesingleconfirm
msgid "Are you sure you want to delete the selected file?"
