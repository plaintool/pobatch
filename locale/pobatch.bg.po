#: batchop.rrenametitle
msgid "Rename files"
msgstr "Преименуване на файлове"

#: batchop.rselectdeletemessage
msgid "Select file to delete!"
msgstr "Изберете файл за изтриване!"

#: batchop.rselectrenamemessage
msgid "Select file(s) to rename!"
msgstr "Изберете файл(и) за преименуване!"

#: batchop.rsyncconfirm
#, object-pascal-format
msgid ""
"Synchronize the following %d file(s) with\n"
"their matching POT files?\n"
"This action cannot be undone within the application.\n"
"\n"
"%s"
msgstr ""
"Синхронизирайте ли следващите %d файл(a) със\n"
"съответните им POT файлове?\n"
"Това действие не може да бъде отменено в приложението.\n"
"\n"
"%s"

#: batchop.rsynccurrentconfirm
#, object-pascal-format
msgid ""
"Synchronize current file\n"
"  %s\n"
"with reference POT\n"
"  %s ?"
msgstr ""
"Синхронизирайте ли текущия файл\n"
"  %s\n"
"със свързания POT\n"
"  %s ?"

#: batchop.rsyncdone
msgid "Synchronization complete."
msgstr "Синхронизацията е завършена."

#: batchop.rsyncdoneskipped
#, object-pascal-format
msgid "Synchronization complete. %d file(s) skipped (no matching POT)."
msgstr "Синхронизацията е завършена. %d файл беше пропуснат (не съответстващ POT)."

#: batchop.rtargetlangnotset
msgid "Target language is not set. Please specify the Language header in the PO file."
msgstr "Целевият език не е зададен. Моля, укажете заглавието на езика в PO файла."

#: batchop.rtranslateall
msgid "Translate all entries in the current file?"
msgstr "Искате ли да превеждате всички записи в текущия файл?"

