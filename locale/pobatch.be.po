"File \"%s\": translation service returned %d lines instead of %d; single-line entries were skipped.\n"
"\n"
"Response:\n"
"%s"
msgstr ""
"Файл \"%s\": сэрвіс перакладу вярнуў %d радкаў замест %d; адзінрадковыя запісы былі прапушаны.\n"
"\n"
"Adpoved: \n"
"%s"

#: batchop.rtranslationlinecountgrid
#, object-pascal-format
msgid ""
"Translation service returned %d lines instead of %d; single-line entries were skipped.\n"
"\n"
"Response:\n"
"%s"
msgstr ""
"Сэрвіс перакладу вярнуў %d радкаў замест %d; адзінрадковыя запісы былі прапушаны.\n"
"\n"
"Adpoved: \n"
"%s"

