msgctxt "consts.rfilechangedmsgsave"
msgid "You have unsaved changes. What would you like to do?"
msgstr "저장하지 않은 변경 사항이 있습니다. 어떻게 하시겠습니까?"

#: consts.rfilechangedoverwrite
msgctxt "consts.rfilechangedoverwrite"
msgid "Overwrite"
msgstr "덮어쓰기"

#: consts.rfilechangedreload
msgctxt "consts.rfilechangedreload"
msgid "Reload"
msgstr "다시 로드"

#: consts.rfilechangedreloaddisk
msgctxt "consts.rfilechangedreloaddisk"
msgid "Reload from disk"
msgstr "디스크에서 다시 로드"

#: consts.rfilechangedtitle
msgctxt "consts.rfilechangedtitle"
