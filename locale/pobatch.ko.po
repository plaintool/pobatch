msgstr "이 복수형을 삭제하시겠습니까?"

#: consts.rdeletepluraltitle
msgctxt "consts.rdeletepluraltitle"
msgid "Delete plural form?"
msgstr "복수형을 삭제하시겠습니까?"

#: consts.rdeleterowconfirm
msgctxt "consts.rdeleterowconfirm"
