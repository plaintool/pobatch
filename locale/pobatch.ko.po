#: batchop.rcancelledpath
#, object-pascal-format
msgid "Translation cancelled. %d translation(s) in %d file(s)."
msgstr "번역이 취소되었습니다. %d개 파일에서 %d개 번역."

#: batchop.rcancelledtranslation
#, object-pascal-format
msgid "Translation cancelled. %d entries updated."
msgstr "번역이 취소되었습니다. %d개 항목이 업데이트되었습니다."

#: batchop.rclearallconfirm
#, object-pascal-format
msgid ""
"Clear ALL translations in the following %d file(s)?\n"
"Headers are preserved, all msgstr values are removed.\n"
"This action cannot be undone within the application.\n"
"\n"
"%s"
msgstr ""
"다음 %d개 파일의 모든 번역을 지우시겠습니까?\n"
"헤더는 유지되고 모든 msgstr 값이 제거됩니다.\n"
"이 작업은 애플리케이션 내에서 취소할 수 없습니다.\n"
"\n"
"%s"

#: batchop.rclearalltitle
msgid "Clear all translations"
msgstr "모든 번역 지우기"

#: batchop.rclearedtranslationscount
#, object-pascal-format
msgid "%d translations were cleared."
msgstr "%d개 번역이 지워졌습니다."

#: batchop.rclearfuzzyconfirm
#, object-pascal-format
msgid ""
"Clear translations of fuzzy entries in the following %d file(s)?\n"
"This action cannot be undone within the application.\n"
"\n"
"%s"
msgstr ""
"다음 %d개 파일의 fuzzy 항목 번역을 지우시겠습니까?\n"
"이 작업은 애플리케이션 내에서 취소할 수 없습니다.\n"
"\n"
"%s"

#: batchop.rclearidenticalconfirm
msgid "Clear translations that are identical to the source text in the selected row(s)?"
msgstr "선택한 행에서 원문과 동일한 번역을 지우시겠습니까?"

#: batchop.rclearinvalidtitle
msgid "Clear invalid translations"
msgstr "유효하지 않은 번역 지우기"

#: batchop.rconfirmrenametitle
msgid "Confirm rename"
msgstr "이름 바꾸기 확인"

#: batchop.rconfirmsynctitle
msgid "Confirm synchronization"
msgstr "동기화 확인"

#: batchop.rcopiedtranslationscount
#, object-pascal-format
msgid "%d translations were copied."
msgstr "%d개 번역이 복사되었습니다."

#: batchop.rcopysourceemptyconfirm
#, object-pascal-format
msgid ""
"Copy source text to empty translations in the following %d file(s)?\n"
"This action cannot be undone within the application.\n"
"\n"
"%s"
msgstr ""
"다음 %d개 파일의 빈 번역에 원문을 복사하시겠습니까?\n"
"이 작업은 애플리케이션 내에서 취소할 수 없습니다.\n"
"\n"
"%s"

#: batchop.rcopysourceemptytitle
msgid "Copy source to empty"
msgstr "원문을 빈 번역에 복사"

#: batchop.rcopysourcetotranslationconfirm
msgid "Copy source text to translations in the selected row(s)?"
msgstr "선택한 행의 번역에 원문을 복사하시겠습니까?"

#: batchop.rdeletefilestitle
msgid "Delete files"
msgstr "파일 삭제"

#: batchop.rdeletemultipleconfirm
#, object-pascal-format
msgid ""
"Are you sure you want to delete the following %d file(s)?\n"
"\n"
"%s"
msgstr ""
"다음 %d개 파일을 삭제하시겠습니까?\n"
"\n"
"%s"

#: batchop.rdeletesingleconfirm
msgid "Are you sure you want to delete the selected file?"
msgstr "선택한 파일을 삭제하시겠습니까?"

#: batchop.rdeletetitle
msgid "Delete file"
msgstr "파일 삭제"

#: batchop.rdoneinvalidcleared
#, object-pascal-format
msgid "Done. %d invalid translation(s) cleared."
msgstr "완료. 유효하지 않은 번역 %d개가 지워졌습니다."

#: batchop.rdonetranslationsadded
#, object-pascal-format
msgid "Done. %d translation(s) added in %d file(s). %d file(s) skipped."
msgstr "완료. %d개 파일에 번역 %d개가 추가되었습니다. %d개 파일을 건너뛰었습니다."

#: batchop.rdonetranslationscleared
#, object-pascal-format
msgid "Done. %d translation(s) cleared."
msgstr "완료. 번역 %d개가 지워졌습니다."

#: batchop.rdonetranslationsfilled
#, object-pascal-format
msgid "Done. %d translation(s) filled from source."
msgstr "완료. 원문에서 번역 %d개를 채웠습니다."

#: batchop.rerrorprocessingfile
#, object-pascal-format
msgid "Error processing file \"%s\": %s"
msgstr "파일 \"%s\" 처리 중 오류: %s"

#: batchop.rerrorsynccurrent
#, object-pascal-format
msgid "Error synchronizing file: %s"
msgstr "파일 동기화 중 오류: %s"

#: batchop.rerrorsyncfile
#, object-pascal-format
msgid "Error synchronizing file \"%s\": %s"
msgstr "파일 \"%s\" 동기화 중 오류: %s"

#: batchop.rfilelangnotset
#, object-pascal-format
msgid "File \"%s\" skipped: target language is not set in the PO header or file name."
msgstr "파일 \"%s\"을(를) 건너뛰었습니다: PO 헤더 또는 파일 이름에 대상 언어가 설정되지 않았습니다."

#: batchop.rfilenotfound
#, object-pascal-format
msgid "File not found: %s"
msgstr "파일을 찾을 수 없음: %s"

#: batchop.rfilesexistconfirm
#, object-pascal-format
msgid ""
"The following files already exist:\n"
"\n"
"%s\n"
"Overwrite them?"
msgstr ""
"다음 파일이 이미 존재합니다:\n"
"\n"
"%s\n"
"덮어쓰시겠습니까?"

#: batchop.rfilesexisttitle
msgid "Files exist"
msgstr "파일이 존재함"

#: batchop.rfiletranslationnone
#, object-pascal-format
msgid "File \"%s\" skipped: no translations were produced for language \"%s\"."
msgstr "파일 \"%s\"을(를) 건너뛰었습니다: \"%s\" 언어에 대한 번역이 생성되지 않았습니다."

#: batchop.rlangsconsoleerror
msgid "Error: --langs is required in console mode"
msgstr "오류: 콘솔 모드에서는 --langs가 필요합니다"

#: batchop.rmarkedvalidcount
#, object-pascal-format
msgid "%d entries marked as valid."
msgstr "%d개 항목이 유효한 것으로 표시되었습니다."

#: batchop.rmarkvalidconfirm
#, object-pascal-format
msgid ""
"Mark the following %d file(s) as valid?\n"
"This will remove the \"fuzzy\" flag from all entries.\n"
"This action cannot be undone within the application.\n"
"\n"
"%s"
msgstr ""
"다음 %d개 파일을 유효한 것으로 표시하시겠습니까?\n"
"모든 항목에서 \"fuzzy\" 플래그가 제거됩니다.\n"
"이 작업은 애플리케이션 내에서 취소할 수 없습니다.\n"
"\n"
"%s"

#: batchop.rmarkvaliddone
msgid "Selected files have been marked as valid. All \"fuzzy\" flags were removed."
msgstr "선택한 파일이 유효한 것으로 표시되었습니다. 모든 \"fuzzy\" 플래그가 제거되었습니다."

#: batchop.rmarkvalidgridconfirm
#, object-pascal-format
msgid ""
"Mark %d selected entries as valid?\n"
"This will remove the \"fuzzy\" flag from the selected entries."
msgstr ""
"선택한 %d개 항목을 유효한 것으로 표시하시겠습니까?\n"
"선택한 항목에서 \"fuzzy\" 플래그가 제거됩니다."

#: batchop.rmarkvalidgridtitle
msgid "Mark as Valid"
msgstr "유효한 것으로 표시"

#: batchop.rmemorydisabled
msgid "Translation memory is disabled. Enable it in the settings."
msgstr "번역 메모리가 비활성화되어 있습니다. 설정에서 활성화하십시오."

#: batchop.rmemorynotconfigured
msgid "Translation memory is not configured for the current language pair."
msgstr "현재 언어 쌍에 대해 번역 메모리가 구성되지 않았습니다."

#: batchop.rmemorytranslatedone
#, object-pascal-format
msgid "Done. %d translation(s) applied from memory."
msgstr "완료. 메모리에서 번역 %d개를 적용했습니다."

#: batchop.rmemorytranslatedoneskipped
#, object-pascal-format
msgid "Done. %d translation(s) applied from memory, %d skipped."
msgstr "완료. 메모리에서 번역 %d개를 적용하고 %d개를 건너뛰었습니다."

#: batchop.rmorefiles
#, object-pascal-format
msgid "... and %d more file(s)"
msgstr "... 외 %d개 파일"

#: batchop.rmorelines
#, object-pascal-format
msgid "... and %d more line(s)"
msgstr "... 외 %d개 줄"

#: batchop.rnameconsoleerror
msgid "Error: --name is required in console mode"
msgstr "오류: 콘솔 모드에서는 --name이 필요합니다"

#: batchop.rnofuzzyentries
msgid "No fuzzy entries in the selection."
msgstr "선택 항목에 fuzzy 항목이 없습니다."

#: batchop.rnopofilesselected
msgid "No PO files selected."
msgstr "선택한 PO 파일이 없습니다."

#: batchop.rnopotforfile
#, object-pascal-format
msgid "No matching POT file found for: %s"
msgstr "다음에 대한 일치하는 POT 파일을 찾을 수 없음: %s"

#: batchop.rnosyncselected
msgid "No PO files selected for synchronization."
msgstr "동기화할 PO 파일이 선택되지 않았습니다."

#: batchop.rnothingtranslated
msgid "Nothing to translate."
msgstr "번역할 항목이 없습니다."

#: batchop.rnothingtranslatedall
msgid "Nothing to translate: all entries already have translations."
msgstr "번역할 항목이 없습니다: 모든 항목에 이미 번역이 있습니다."

#: batchop.rpotconsoleerror
msgid "Error: --pot is required in console mode"
msgstr "오류: 콘솔 모드에서는 --pot이 필요합니다"

#: batchop.rpotnotfound
#, object-pascal-format
msgctxt "batchop.rpotnotfound"
msgid "POT file not found: %s"
msgstr "POT 파일을 찾을 수 없음: %s"

#: batchop.rrememberconfirm
#, object-pascal-format
msgid ""
"Remember translations from the following %d file(s) into the memory?\n"
"\n"
"%s"
msgstr ""
"다음 %d개 파일의 번역을 메모리에 기억하시겠습니까?\n"
"\n"
"%s"

#: batchop.rrememberdone
#, object-pascal-format
msgctxt "batchop.rrememberdone"
msgid "Done. %d translation(s) remembered, %d skipped."
msgstr "완료. 번역 %d개를 기억하고 %d개를 건너뛰었습니다."

#: batchop.rremembertitle
msgid "Remember translations"
msgstr "번역 기억하기"

#: batchop.rremovefuzzytitle
msgid "Remove fuzzy flag"
msgstr "fuzzy 플래그 제거"

#: batchop.rrenameconfirm
#, object-pascal-format
msgid ""
"Rename the following %d file(s) using base name \"%s\"?\n"
"\n"
"%s"
msgstr ""
"다음 %d개 파일의 이름을 기본 이름 \"%s\"(으)로 바꾸시겠습니까?\n"
"\n"
"%s"

#: batchop.rrenamefailed
#, object-pascal-format
msgid "Failed to rename: %s"
msgstr "이름 바꾸기 실패: %s"

#: batchop.rrenameprompt
msgid "Enter new base name:"
msgstr "새 기본 이름 입력:"

#: batchop.rrenametitle
msgid "Rename files"
msgstr "파일 이름 바꾸기"

#: batchop.rselectdeletemessage
msgid "Select file to delete!"
msgstr "삭제할 파일을 선택하십시오!"

#: batchop.rselectrenamemessage
msgid "Select file(s) to rename!"
msgstr "이름을 바꿀 파일을 선택하십시오!"

#: batchop.rsyncconfirm
#, object-pascal-format
msgid ""
"Synchronize the following %d file(s) with\n"
"their matching POT files?\n"
"This action cannot be undone within the application.\n"
"\n"
"%s"
msgstr ""
"다음 %d개 파일을 해당 POT 파일과\n"
"동기화하시겠습니까?\n"
"이 작업은 애플리케이션 내에서 취소할 수 없습니다.\n"
"\n"
"%s"

#: batchop.rsynccurrentconfirm
#, object-pascal-format
msgid ""
"Synchronize current file\n"
"  %s\n"
"with reference POT\n"
"  %s ?"
msgstr ""
"현재 파일\n"
"  %s\n"
"을(를) 참조 POT\n"
"  %s 과(와) 동기화하시겠습니까?"

#: batchop.rsyncdone
msgid "Synchronization complete."
msgstr "동기화가 완료되었습니다."

#: batchop.rsyncdoneskipped
#, object-pascal-format
msgid "Synchronization complete. %d file(s) skipped (no matching POT)."
msgstr "동기화가 완료되었습니다. %d개 파일을 건너뛰었습니다(일치하는 POT 없음)."

#: batchop.rtargetlangnotset
msgid "Target language is not set. Please specify the Language header in the PO file."
msgstr "대상 언어가 설정되지 않았습니다. PO 파일의 Language 헤더를 지정하십시오."

#: batchop.rtranslateall
msgid "Translate all entries in the current file?"
msgstr "현재 파일의 모든 항목을 번역하시겠습니까?"

#: batchop.rtranslateallmissing
msgid "Translate all missing translations in the current file?"
msgstr "현재 파일의 모든 누락된 번역을 번역하시겠습니까?"

#: batchop.rtranslatedone
#, object-pascal-format
msgid "Translation complete. %d entries updated."
msgstr "번역이 완료되었습니다. %d개 항목이 업데이트되었습니다."

#: batchop.rtranslatedoneskipped
#, object-pascal-format
msgid "Translation complete. %d entries updated, %d skipped."
msgstr "번역이 완료되었습니다. %d개 항목이 업데이트되고 %d개를 건너뛰었습니다."

#: batchop.rtranslatemissingconfirm
#, object-pascal-format
msgid ""
"Translate missing translations in the following %d file(s)?\n"
"This action cannot be undone within the application.\n"
"\n"
"%s"
msgstr ""
"다음 %d개 파일의 누락된 번역을 번역하시겠습니까?\n"
"이 작업은 애플리케이션 내에서 취소할 수 없습니다.\n"
"\n"
"%s"

#: batchop.rtranslatemissingselected
#, object-pascal-format
msgid "Translate missing translations in %d selected entries?"
msgstr "선택한 %d개 항목의 누락된 번역을 번역하시겠습니까?"

#: batchop.rtranslatemissingtitle
msgid "Translate missing"
msgstr "누락된 번역 번역"

#: batchop.rtranslateselected
#, object-pascal-format
msgid "Translate %d selected entries?"
msgstr "선택한 %d개 항목을 번역하시겠습니까?"

#: batchop.rtranslationconfignotselected
msgid "Translation configuration is not selected. Please choose a translation service first."
msgstr "번역 구성이 선택되지 않았습니다. 먼저 번역 서비스를 선택하십시오."

#: batchop.rtranslationerror
#, object-pascal-format
msgid "Translation error: %s"
msgstr "번역 오류: %s"

#: batchop.rtranslationlinecount
#, object-pascal-format
msgid ""
"File \"%s\": translation service returned %d lines instead of %d; single-line entries were skipped.\n"
"\n"
"Response:\n"
"%s"
msgstr ""
"파일 \"%s\": 번역 서비스가 %d줄 대신 %d줄을 반환했습니다. 한 줄 항목을 건너뛰었습니다.\n"
"\n"
"응답:\n"
"%s"

#: batchop.rtranslationlinecountgrid
#, object-pascal-format
msgid ""
"Translation service returned %d lines instead of %d; single-line entries were skipped.\n"
"\n"
"Response:\n"
"%s"
msgstr ""
"번역 서비스가 %d줄 대신 %d줄을 반환했습니다. 한 줄 항목을 건너뛰었습니다.\n"
"\n"
"응답:\n"
"%s"

