#: consts.rdeleterowsconfirm
msgctxt "consts.rdeleterowsconfirm"
msgid "Delete selected rows?"
msgstr "선택한 행을 삭제하시겠습니까?"

#: consts.rdeleterowtitle
msgctxt "consts.rdeleterowtitle"
msgid "Delete row"
msgstr "행 삭제"

#: consts.rdiscardchanges
msgctxt "consts.rdiscardchanges"
msgid "Do you want to discard all unsaved changes?"
msgstr "저장하지 않은 모든 변경 사항을 취소하시겠습니까?"

#: consts.rerrorinvalidfilename
msgctxt "consts.rerrorinvalidfilename"
msgid "Invalid file name"
msgstr "잘못된 파일 이름"

#: consts.rerrornotexist
#, object-pascal-format
msgctxt "consts.rerrornotexist"
msgid ""
"File does not exist:\n"
"%s"
msgstr ""
"파일이 존재하지 않습니다:\n"
"%s"

#: consts.rerrornotexistine
#, object-pascal-format
msgctxt "consts.rerrornotexistine"
msgid "File does not exist: %s"
msgstr "파일이 존재하지 않습니다: %s"

#: consts.rerrortitle
msgctxt "consts.rerrortitle"
msgid "Error"
msgstr "오류"

#: consts.rfilechangedcancel
msgctxt "consts.rfilechangedcancel"
msgid "Cancel"
msgstr "취소"

#: consts.rfilechangedkeepchanges
msgctxt "consts.rfilechangedkeepchanges"
msgid "Keep my changes"
msgstr "내 변경 사항 유지"

#: consts.rfilechangedmsg
#, object-pascal-format
msgctxt "consts.rfilechangedmsg"
msgid "The file \"%s\" has been modified by another application since it was opened."
msgstr "파일 \"%s\"이(가) 열린 후 다른 애플리케이션에 의해 수정되었습니다."

#: consts.rfilechangedmsgactivate
msgctxt "consts.rfilechangedmsgactivate"
msgid "You have unsaved changes. Keep them or reload from disk?"
msgstr "저장하지 않은 변경 사항이 있습니다. 유지하시겠습니까, 아니면 디스크에서 다시 로드하시겠습니까?"

