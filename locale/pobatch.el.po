#, object-pascal-format
msgid "%d entries marked as valid."
msgstr "Επισημάνθηκαν %d καταχωρίσεις ως έγκυρες."

#: batchop.rmarkvalidconfirm
#, object-pascal-format
msgid ""
"Mark the following %d file(s) as valid?\n"
"This will remove the \"fuzzy\" flag from all entries.\n"
"This action cannot be undone within the application.\n"
"\n"
"%s"
