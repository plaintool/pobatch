msgid "Selected files have been marked as valid. All \"fuzzy\" flags were removed."
msgstr "تم تعليم الملفات المحددة كصالحة. تمت إزالة جميع علامات \"fuzzy\"."

#: batchop.rmarkvalidgridconfirm
#, object-pascal-format
msgid ""
"Mark %d selected entries as valid?\n"
"This will remove the \"fuzzy\" flag from the selected entries."
msgstr ""
"هل تريد تعليم %d مدخلة محددة كصالحة؟\n"
"سيؤدي هذا إلى إزالة علامة \"fuzzy\" من المدخلات المحددة."

#: batchop.rmarkvalidgridtitle
msgid "Mark as Valid"
msgstr "تعليم كصالحة"

#: batchop.rmemorydisabled
msgid "Translation memory is disabled. Enable it in the settings."
msgstr "ذاكرة الترجمة معطلة. قم بتمكينها في الإعدادات."

#: batchop.rmemorynotconfigured
msgid "Translation memory is not configured for the current language pair."
msgstr "ذاكرة الترجمة غير مهيأة لزوج اللغات الحالي."

#: batchop.rmemorytranslatedone
#, object-pascal-format
msgid "Done. %d translation(s) applied from memory."
msgstr "تم. تم تطبيق %d ترجمة من الذاكرة."

#: batchop.rmemorytranslatedoneskipped
#, object-pascal-format
msgid "Done. %d translation(s) applied from memory, %d skipped."
msgstr "تم. تم تطبيق %d ترجمة من الذاكرة، وتم تخطي %d."

#: batchop.rmorefiles
#, object-pascal-format
msgid "... and %d more file(s)"
msgstr "... و %d ملف إضافي"

#: batchop.rmorelines
#, object-pascal-format
msgid "... and %d more line(s)"
msgstr "... و %d سطر إضافي"

