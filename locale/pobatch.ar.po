#: batchop.rfilenotfound
#, object-pascal-format
msgid "File not found: %s"
msgstr "الملف غير موجود: %s"

#: batchop.rfilesexistconfirm
#, object-pascal-format
msgid ""
"The following files already exist:\n"
"\n"
"%s\n"
"Overwrite them?"
msgstr ""
"الملفات التالية موجودة بالفعل:\n"
"\n"
"%s\n"
"هل تريد الكتابة فوقها؟"

#: batchop.rfilesexisttitle
msgid "Files exist"
msgstr "الملفات موجودة"

#: batchop.rfiletranslationnone
#, object-pascal-format
msgid "File \"%s\" skipped: no translations were produced for language \"%s\"."
msgstr "تم تخطي الملف \"%s\": لم يتم إنتاج أي ترجمات للغة \"%s\"."

#: batchop.rlangsconsoleerror
msgid "Error: --langs is required in console mode"
msgstr "خطأ: --langs مطلوب في وضع الطرفية"

#: batchop.rmarkedvalidcount
#, object-pascal-format
msgid "%d entries marked as valid."
msgstr "تم تعليم %d مدخلة كصالحة."

#: batchop.rmarkvalidconfirm
#, object-pascal-format
msgid ""
"Mark the following %d file(s) as valid?\n"
"This will remove the \"fuzzy\" flag from all entries.\n"
"This action cannot be undone within the application.\n"
"\n"
"%s"
msgstr ""
"هل تريد تعليم الملفات التالية (%d) كصالحة؟\n"
"سيؤدي هذا إلى إزالة علامة \"fuzzy\" من جميع المدخلات.\n"
"لا يمكن التراجع عن هذا الإجراء داخل التطبيق.\n"
"\n"
"%s"

