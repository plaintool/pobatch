      <XPManifest>
        <DpiAware Value="True"/>
        <TextName Value="pobatch"/>
        <TextDesc Value="PoBatch is an easy-to-use PO file editor for l10n workflows. It displays source strings and translations in a grid, allowing selection of columns or rows and bulk copy and paste operations. This makes it easy to quickly update translations within a PO file."/>
      </XPManifest>
      <Icon Value="0"/>
      <Resources Count="29">
